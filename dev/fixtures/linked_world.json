    "conversations": {
      "a:merchant": {
        "compiled": "{\"inkVersion\":21,\"root\":[[{\"->\":\"greeting\"},[\"done\",{\"#n\":\"g-0\"}],null],\"done\",{\"greeting\":[[\"ev\",{\"VAR?\":\"found_dry_basin\"},\"/ev\",[{\"->\":\".^.b\",\"c\":true},{\"b\":[\"\\n\",\"^The merchant turns a cracked cup in his hands. \\\"So the singing spring has fallen silent? I should stop promising thirsty travelers a drink.\\\"\",\"\\n\",{\"->\":\".^.^.^.5\"},null]}],[{\"->\":\".^.b\"},{\"b\":[\"\\n\",\"^The merchant shades his stall with a woven cloth. \\\"A little honest work leaves the evening free for wonders.\\\"\",\"\\n\",{\"->\":\".^.^.^.5\"},null]}],\"nop\",\"\\n\",\"ev\",\"str\",\"^Ask about the old workshop.\",\"/str\",\"/ev\",{\"*\":\".^.c-0\",\"flg\":4},\"ev\",\"str\",\"^Ask for a small delivery.\",\"/str\",{\"VAR?\":\"has_delivery\"},\"!\",{\"VAR?\":\"finished_delivery\"},\"!\",\"&&\",\"/ev\",{\"*\":\".^.c-1\",\"flg\":5},\"ev\",\"str\",\"^Discuss the provisions delivery.\",\"/str\",{\"VAR?\":\"has_delivery\"},\"/ev\",{\"*\":\".^.c-2\",\"flg\":5},\"ev\",\"str\",\"^Mention the completed delivery.\",\"/str\",{\"VAR?\":\"finished_delivery\"},\"/ev\",{\"*\":\".^.c-3\",\"flg\":5},\"ev\",\"str\",\"^Leave the merchant to his work.\",\"/str\",\"/ev\",{\"*\":\".^.c-4\",\"flg\":4},{\"c-0\":[\"\\n\",\"ev\",{\"VAR?\":\"found_passage\"},\"/ev\",[{\"->\":\".^.b\",\"c\":true},{\"b\":[\"\\n\",\"^\\\"You found the side passage yourself? Then you know more than the men who sell directions to it.\\\"\",\"\\n\",{\"->\":\".^.^.^.6\"},null]}],[{\"->\":\".^.b\"},{\"b\":[\"\\n\",\"^\\\"They say a narrow passage beyond the workshop leads to a spring that sings after sunset. I heard it from a boatman; I have never tasted its water.\\\"\",\"\\n\",{\"->\":\".^.^.^.6\"},null]}],\"nop\",\"\\n\",\"#\",\"^command:passage_rumor\",\"/#\",\"#\",\"^command:water_rumor\",\"/#\",{\"->\":\"farewell\"},null],\"c-1\":[\"\\n\",\"^\\\"The courier needs provisions. Bring the agreed goods before the deadline; the payment is set aside.\\\"\",\"\\n\",\"#\",\"^command:accept_provisions\",\"/#\",{\"->\":\"farewell\"},null],\"c-2\":[\"\\n\",\"^\\\"Find the courier during working hours. The workshop bench is yours to use, but a deadline waits for no oven.\\\"\",\"\\n\",{\"->\":\"farewell\"},null],\"c-3\":[\"\\n\",\"^\\\"The courier spoke well of you. Reliable hands are worth more than loud promises.\\\"\",\"\\n\",{\"->\":\"farewell\"},null],\"c-4\":[\"\\n\",\"end\",null]}],null],\"farewell\":[[\"ev\",\"str\",\"^Thank him and leave.\",\"/str\",\"/ev\",{\"*\":\".^.c-0\",\"flg\":4},{\"c-0\":[\"\\n\",\"end\",null]}],null],\"global decl\":[\"ev\",false,{\"VAR=\":\"found_passage\"},false,{\"VAR=\":\"found_dry_basin\"},false,{\"VAR=\":\"has_delivery\"},false,{\"VAR=\":\"finished_delivery\"},\"/ev\",\"end\",null]}],\"listDefs\":{}}",
