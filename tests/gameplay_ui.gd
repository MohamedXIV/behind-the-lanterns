	check(view.find_child("DialogueSpeaker", true, false).text.contains("Merchant"), "speaker identity visible")
	await tap(map, m.position_of("a:courier"))
	await frames(100)
	view.find_child("Talk", true, false).pressed.emit()
	check(view.find_child("DialogueSpeaker", true, false).text.contains("Courier"), "world Talk switches to second character")
	check(view.find_child("SharedCommitments", true, false).text.contains("Kept commitment"), "conversation presents actual shared work memory")
	# Optional river activity through real touch navigation and fishing controls.
	check(m.move_actor("ui-bait", "a:player", 160, 160).ok and m.act("ui-grain", "a:player", "a:supplies", "item.grain", 2, "take").ok, "gather bait for UI fishing")
	map.sync_position()
	await touch(map, Vector2(700, 330))
	await frames(220)
	view.find_child("Use nearby", true, false).pressed.emit()
	await touch(map, Vector2(220, 180))
	await frames(100)
	view.find_child("Use nearby", true, false).pressed.emit()
	check(m.actor_region("a:player") == "region.river", "touch navigation explores river region")
	select_id(view.find_child("FishingBait", true, false), "item.grain")
	view.find_child("CastLine", true, false).pressed.emit()
	await frames(135)
	check(view.find_child("FishingStatus", true, false).text.contains("REEL NOW"), "readable active-time bite feedback")
	view.find_child("ReelLine", true, false).pressed.emit()
	check(m.fishing.attempt(m.session.snapshot(), "a:player").status == "caught", "touch-sized reel control awards catch")
	# Cultivation and offscreen world-time growth through touch navigation and Farming UI.
	await touch(map, Vector2(480, 320))
	await frames(120)
	view.find_child("Use nearby", true, false).pressed.emit()
	check(view.find_child("SidebarTabs", true, false).current_tab == 4 and view.find_child("FarmingStatus", true, false).text.contains("Riverbank silt bed"), "Use nearby opens Farming tab for riverbank plot")
	select_id(view.find_child("FarmingCrop", true, false), "crop.grain")
	view.find_child("PlantCrop", true, false).pressed.emit()
	check(view.find_child("FarmingStatus", true, false).text.contains("NEEDS WATER"), "Plant button plants seed and updates status")
	view.find_child("WaterCrop", true, false).pressed.emit()
	check(m.farming.projection(m.session.snapshot(), "a:river-bed").waterings_done == 1, "Water button records watering care")
	view.find_child("Wait6h", true, false).pressed.emit()
	view.find_child("WaterCrop", true, false).pressed.emit()
	check(view.find_child("FarmingStatus", true, false).text.contains("RIPE TO HARVEST"), "world-time advancement and second watering ripen crop in UI")
	view.find_child("HarvestCrop", true, false).pressed.emit()
	check(m.farming.projection(m.session.snapshot(), "a:river-bed").is_empty() and m.farming.skill(m.session.snapshot(), "a:player") == 1, "Harvest button collects produce and advances cultivation skill")
	# Mobile-first touch controls, running pace, handedness/visibility ergonomics, safe area and pause/resume.
	var touch_controls: TouchControls = view.find_child("TouchControls", true, false)
	var touch_left: Button = view.find_child("TouchLeft", true, false)
	var touch_run: Button = view.find_child("TouchRun", true, false)
	var touch_evade: Button = view.find_child("TouchEvade", true, false)
	check(touch_controls != null and touch_left.custom_minimum_size.y >= 48 and touch_run.custom_minimum_size.y >= 48, "on-screen landscape touch controls have touch-sized minimum heights")
	touch_evade.pressed.emit()
	check(view.find_child("Status", true, false).text.contains("Evade ready"), "combat/evasion touch intent emits decoupled feedback without mutating world state")
	var start_x: float = m.position_of("a:player").x
	touch_run.toggled.emit(true)
	check(view.player_input().is_run_latched() and touch_run.text == "Run: On", "TouchRun button latches running pace")
	touch_left.button_down.emit()
	await frames(25)
	touch_left.button_up.emit()
	await frames(3)
	var run_distance: float = start_x - m.position_of("a:player").x
	check(run_distance > 85.0, "touch directional pad + run toggle moves faster than walking speed and commits position")
	touch_run.toggled.emit(false)
	# Application pause/suspend while holding a touch directional button halts movement and commits safe position.
	var before_pause_x: float = m.position_of("a:player").x
	touch_left.button_down.emit()
	await frames(12)
	view.on_application_paused()
	var paused_x: float = m.position_of("a:player").x
	await frames(20)
	check(paused_x < before_pause_x and m.position_of("a:player").x == paused_x and view.player_input().movement_vector(false) == Vector2.ZERO, "application pause halts movement, clears held touch input, and commits safe position")
	view.on_application_resumed()
	await frames(10)
	check(m.position_of("a:player").x == paused_x, "resuming after pause does not resume phantom movement")
	# Handedness swap, visibility toggle, and compact notched landscape viewport adaptation.
	check(touch_controls.cluster_order()[0] == "DpadCluster", "standard handedness places D-pad on left")
	view.find_child("SwapHands", true, false).pressed.emit()
	check(touch_controls.cluster_order()[0] == "ActionCluster", "SwapHands swaps action cluster to left for left-handed play")
	view.find_child("TouchVisibility", true, false).pressed.emit()
	check(not touch_controls.visible, "TouchVisibility hides on-screen touch controls")
	view.find_child("TouchVisibility", true, false).pressed.emit()
	check(touch_controls.visible, "TouchVisibility restores on-screen touch controls")
	var safe_margins: Dictionary = view.apply_viewport_layout(Vector2i(844, 390), Rect2i(44, 0, 756, 369))
	check(safe_margins.left == 44 and safe_margins.right == 44 and safe_margins.bottom == 21 and safe_margins.compact, "compact notched landscape viewport applies safe-area margins")
	check(not view.find_child("PrototypeSubtitle", true, false).visible and map.custom_minimum_size.x <= 360, "compact viewport trims non-essential subtitle and adapts map minimum size")
	view.apply_viewport_layout(Vector2i(1120, 720), Rect2i())
	# Return to courtyard and exercise Watch / Law panel: witnessed tamper, vouched persuasion, scripted guard arrest, jail dialogue, and fine release.
