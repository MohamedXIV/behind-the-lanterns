	await frames(80)
	view.find_child("Use nearby", true, false).pressed.emit()
	await tap(map, Vector2(620, 160))
	await frames(180)
	view.find_child("Talk", true, false).pressed.emit()
	check(not view.find_child("DialogueText", true, false).text.is_empty(), "world Talk opens Ink dialogue")
	view.find_child("DialogueChoice0", true, false).pressed.emit()
