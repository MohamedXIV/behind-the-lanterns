	await touch(map, m.position_of("a:boatman"))
	await frames(180)
	view.find_child("Use nearby", true, false).pressed.emit()
	check(view.find_child("SidebarTabs", true, false).current_tab == 6 and map.selected_target == "a:boatman", "touch approach and Use open public carrier travel panel")
	check(view.find_child("ConfirmTravel", true, false).custom_minimum_size.y >= 48, "route confirmation has touch-sized minimum height")
	select_id(view.find_child("TravelRoute", true, false), "route.ship_estuary")
	var voyage_wallet: int = m.wallet("a:player")
	var voyage_minute: int = m.session.now()
	view.find_child("ConfirmTravel", true, false).pressed.emit()
	check(m.actor_region("a:player") == "region.estuary" and m.session.now() == voyage_minute + 240 and m.wallet("a:player") == voyage_wallet - 4, "ConfirmTravel pays once, advances world time and arrives in remote region")
	check(map.visual_position() == m.position_of("a:player") and view.find_child("WorldTime", true, false).text.contains("Estuary Quay"), "arrival synchronizes map position and regional presentation")
	check(view.find_child("TravelHistory", true, false).text.contains("salt air"), "optional travel log presents concise authored journey text")
	view.find_child("Save", true, false).pressed.emit()
	var arrived_wallet: int = m.wallet("a:player")
	view.find_child("Use nearby", true, false).pressed.emit()
	select_id(view.find_child("TravelRoute", true, false), "route.ship_return")
	view.find_child("ConfirmTravel", true, false).pressed.emit()
	check(m.actor_region("a:player") == "region.playground" and m.travel.journeys_for(m.session.snapshot(), "a:player").size() == 2, "return carrier supports a second confirmed public journey")
	view.find_child("Load", true, false).pressed.emit()
	check(m.actor_region("a:player") == "region.estuary" and m.wallet("a:player") == arrived_wallet and m.travel.journeys_for(m.session.snapshot(), "a:player").size() == 1, "load restores saved remote arrival, fare and log instead of later return")
