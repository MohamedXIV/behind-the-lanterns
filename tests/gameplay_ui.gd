	await tap(map, m.position_of("a:detainee"))
	await frames(140)
	view.find_child("Talk", true, false).pressed.emit()
	check(view.find_child("DialogueSpeaker", true, false).text.contains("Detainee"), "Talk opens Ink conversation with detained porter in watchhouse")
	await tap(map, m.position_of("a:watch-warden"))
	await frames(110)
	view.find_child("Use nearby", true, false).pressed.emit()
	view.find_child("PayFine", true, false).pressed.emit()
	check(m.actor_region("a:player") == "region.playground" and m.law.status_of(m.session.snapshot(), "a:player").status == "clear", "PayFine button settles fine and releases player to courtyard")
	# Public route travel through real touch navigation, contextual Use and explicit fare confirmation.
	view.find_child("Wait6h", true, false).pressed.emit()
