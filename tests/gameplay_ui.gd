	view.find_child("Use nearby", true, false).pressed.emit()
	check(m.actor_region("a:player") == "region.playground", "door returns outside")
	view.find_child("Load", true, false).pressed.emit()
	check(m.actor_region("a:player") == "region.workshop" and map.visual_position() == m.position_of("a:player"), "load restores interior and view position")
	# Conversations through world navigation and real button signals.
