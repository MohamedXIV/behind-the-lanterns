	check(view.find_child("TravelFeedback", true, false).text.contains("restored"), "load clears stale later-journey feedback")
	await _housing_ui()
	app.free()
	for name in RecoveryStore.SLOT_NAMES: DirAccess.remove_absolute(directory.path_join(name))
	DirAccess.remove_absolute(directory)
	_finish()

func _finish() -> void:
	print("GAMEPLAY UI %s: %d assertions, %d failures" % ["PASS" if _failures == 0 else "FAIL", _checks, _failures])
	quit(0 if _failures == 0 else 1)

func _housing_ui() -> void:
	var app = load("res://game/app/main.gd").new()
	root.add_child(app)
	var directory := "user://housing-ui-%d" % OS.get_process_id()
	app.open_playground(directory)
	await frames(3)
	var view = app.get_node("GameplayPlayground")
	var m: GameplayModel = view.model()
	var map = view.find_child("WorldMap", true, false)
	await touch(map, m.position_of("a:merchant"))
	await frames(180)
	select_id(view.find_child("HousingProperty", true, false), "property.inn")
	check(view.find_child("AcquireHousing", true, false).custom_minimum_size.y >= 48 and view.find_child("ConfirmPlacement", true, false).custom_minimum_size.y >= 48, "housing confirmation buttons are touch sized")
	view.find_child("AcquireHousing", true, false).pressed.emit()
	check(m.housing.can_access(m.session.snapshot(), "a:player", "property.inn") and m.wallet("a:player") == 7, "housing UI arranges optional paid room through authority")
	await touch(map, m.position_of("a:workshop-door"))
	await frames(180)
	view.find_child("Use nearby", true, false).pressed.emit()
	await touch(map, m.position_of("a:housing-chest"))
	await frames(120)
	check(m.actor_region("a:player") == "region.workshop" and map.selected_target == "a:housing-chest", "touch picks furniture and approaches its usable side")
	view.find_child("Use nearby", true, false).pressed.emit()
	check(view.find_child("SidebarTabs", true, false).current_tab == 0 and map.selected_target == "a:housing-chest", "contextual Use opens Goods at the approachable furnishing without self-occlusion")
	select_id(view.find_child("HousingProperty", true, false), "property.stable")
	select_id(view.find_child("HousingFurnishing", true, false), "a:housing-chest")
	select_id(view.find_child("HousingCell", true, false), "cell.1")
	check(view.find_child("ConfirmPlacement", true, false).disabled and view.find_child("HousingPreview", true, false).text.contains("occupied"), "preview rejects occupied constrained space")
	select_id(view.find_child("HousingCell", true, false), "cell.3")
	check(not view.find_child("ConfirmPlacement", true, false).disabled, "preview allows available usable space before confirm")
	view.find_child("ConfirmPlacement", true, false).pressed.emit()
	check(m.position_of("a:housing-chest") == Vector2(608, 60), "placement confirmation moves physical chest")
	view.find_child("Save", true, false).pressed.emit()
	await touch(map, m.position_of("a:housing-chest"))
	await frames(180)
	view.find_child("PackFurnishing", true, false).pressed.emit()
	check(not m.position_of("a:housing-chest").is_finite(), "pack button hides packed physical chest")
	view.find_child("Load", true, false).pressed.emit()
	check(m.position_of("a:housing-chest") == Vector2(608, 60) and m.housing.can_access(m.session.snapshot(), "a:player", "property.inn"), "load restores housing permissions and placed furniture")
	app.free()
	for name in RecoveryStore.SLOT_NAMES: DirAccess.remove_absolute(directory.path_join(name))
	DirAccess.remove_absolute(directory)
