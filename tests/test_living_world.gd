extends RefCounted

func run(t) -> void:
	var fixture: RefCounted = load("res://tests/test_narrative.gd").new()
	var m: GameplayModel = fixture._model()
	var starting_money := m.wallet("a:player")
	t.check(m.work.offer_error(m.session.snapshot(), "a:player", "work.favor") == "prior_help_required", "optional favor requires actual prior help")
	t.check(m.move_actor("shop", "a:player", 620, 160).ok and not m.accept_job("early-favor", "a:player", "work.favor").ok, "journal cannot bypass social offer condition")
	t.check(m.accept_job("commit", "a:player", "work.provisions").ok and m.talk("open", "a:player", "a:merchant").ok, "make a real commitment")
	var coins := m.wallet("a:merchant")
	t.check(m.talk("warn", "a:player", "a:merchant", fixture._choice(m, "cannot keep"), 1).ok, "player can warn giver and call off delivery")
	t.check(m.wallet("a:merchant") == coins + 12 and m.work.job_for(m.session.snapshot(), "a:player", "work.provisions").status == "cancelled", "warning returns held payment atomically")
	t.check(m.talk("cancel-context", "a:player", "a:merchant").ok and m.narrative.conversation(m.session.snapshot(), "a:player").frame.text.contains("called off"), "NPC remembers cancellation")
	t.check(m.talk("ack", "a:player", "a:merchant", fixture._choice(m, "Acknowledge"), 1).ok, "acknowledge broken commitment")
	t.check(m.work.job_for(m.session.snapshot(), "a:player", "work.provisions").status == "cancelled" and m.wallet("a:player") == starting_money, "acknowledgement never resets outcome or grants coins")
	var restored := SessionCodec.decode(SessionCodec.encode(m.session), m.session)
	t.check(restored != null and restored.snapshot() == m.session.snapshot(), "social memory and acknowledgement roundtrip")
	if restored != null: restored.close()
	var corrupt := m.session.snapshot()
	corrupt.domains.narrative.acknowledgements["a:player"]["work.provisions"]["a:private"] = true
	t.check(m.session.restore_candidate(corrupt) == null, "unrelated NPC acknowledgement rejected")
	t.check(m.wait_minutes("courier-hours", "a:player", 60).ok and m.move_actor("courier-apology", "a:player", 600, 320).ok and m.talk("courier-memory", "a:player", "a:courier").ok and fixture._choice(m, "Acknowledge") >= 0, "telling giver does not claim recipient heard apology")
	t.check(m.talk("courier-ack", "a:player", "a:courier", fixture._choice(m, "Acknowledge"), 1).ok and m.session.snapshot().domains.narrative.acknowledgements["a:player"]["work.provisions"].size() == 2, "each affected person can be acknowledged independently")
	m.session.close()
	m = fixture._model()
	t.check(m.move_actor("shop", "a:player", 620, 160).ok and m.accept_job("commit", "a:player", "work.provisions").ok and m.wait_minutes("skip", "a:player", 360).ok, "time skip resolves missed commitment")
	t.check(m.talk("missed", "a:player", "a:merchant").ok and m.narrative.conversation(m.session.snapshot(), "a:player").frame.text.contains("waiting"), "missed deadline changes actual NPC response")
	t.check(m.talk("apology", "a:player", "a:merchant", fixture._choice(m, "Acknowledge"), 1).ok and m.talk("after", "a:player", "a:merchant").ok and m.narrative.conversation(m.session.snapshot(), "a:player").frame.text.contains("spoken about"), "acknowledged failure has distinct response")
	t.check(m.work.memories(m.session.snapshot(), "a:player", "a:courier").contains("Missed deadline"), "recipient remembers missed parcel")
	t.check(m.act("trade", "a:player", "a:merchant", "item.dates", 1, "buy", 3).ok, "missed commitment does not gate ordinary trade")
	m.session.close()
	m = fixture._model()
	t.check(m.act("dates", "a:player", "a:supplies", "item.dates", 1, "take").ok and m.act("grain", "a:player", "a:supplies", "item.grain", 6, "take").ok, "gather goods for connected favors")
	t.check(m.move_actor("shop", "a:player", 620, 160).ok and m.accept_job("primary", "a:player", "work.provisions").ok, "accept first commitment")
	t.check(m.move_actor("bench", "a:player", 220, 320).ok and m.start_craft("cook", "a:player", "recipe.provisions", "a:workbench").ok and m.progress_craft("finish", "a:player", 3).ok, "prepare provisions")
	t.check(m.wait_minutes("morning", "a:player", 60).ok and m.move_actor("courier", "a:player", 600, 320).ok and m.deliver_job("primary-deliver", "a:player", "work.provisions").ok, "keep primary commitment")
	t.check(m.move_actor("return", "a:player", 620, 160).ok and m.talk("thanks", "a:player", "a:merchant").ok, "return after reliable help")
	t.check(fixture._choice(m, "reliable help") >= 0 and m.talk("favor", "a:player", "a:merchant", fixture._choice(m, "reliable help"), 1).ok, "reliable help offers optional second errand")
	t.check(m.move_actor("courier-again", "a:player", 600, 320).ok and m.talk("favor-open", "a:player", "a:courier").ok and m.talk("favor-deliver", "a:player", "a:courier", fixture._choice(m, "grain favor"), 1).ok, "follow-up has real goods handover through Ink")
	t.check(m.wallet("a:player") == starting_money + 20 and m.inventory.contents(m.session.snapshot(), "a:player").is_empty(), "both favors conserve goods and pay only held rewards")
	t.check(m.work.memories(m.session.snapshot(), "a:player", "a:merchant").count("Kept commitment") == 2, "shared memory shows two kept commitments")
	m.session.close()
	var data: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://dev/fixtures/linked_world.json"))
	data.work["work.provisions"]["requires_completed"] = "work.favor"
	t.check(GameplayModel.create(data, "world.cycle") == null, "cyclic follow-up content rejected")
